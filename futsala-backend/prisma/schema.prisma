// Prisma Schema for Simple Multi-Tenant Futsal Booking SaaS App
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// Enums
// --------------------------------------

enum UserRole {
  SUPERADMIN
  TENANT_ADMIN
  CUSTOMER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// --------------------------------------
// 1. Simple Tenant Model (Organization / Futsal Chain)
// --------------------------------------

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  email       String?
  phoneNumber String?
  address     String?
  city        String?
  logo        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users       User[]
  venues      Venue[]

  @@map("tenants")
}

// --------------------------------------
// 2. User Model
// --------------------------------------

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  fullName            String
  phoneNumber         String
  role                UserRole             @default(CUSTOMER)
  isVerified          Boolean              @default(false)
  tenantId            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Relations
  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  venues              Venue[]
  bookings            Booking[]
  passwordResetTokens PasswordResetToken[]

  @@index([tenantId])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// --------------------------------------
// 3. Venue & Court Models
// --------------------------------------

model Venue {
  id           String    @id @default(uuid())
  name         String
  description  String
  address      String
  city         String
  latitude     Float?
  longitude    Float?
  phoneNumber  String
  email        String?
  images       String[]
  amenities    String[]
  isActive     Boolean   @default(true)
  rating       Float     @default(0)
  totalReviews Int       @default(0)
  ownerId      String
  tenantId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  courts       Court[]
  bookings     Booking[]

  @@index([ownerId])
  @@index([tenantId])
  @@map("venues")
}

model Court {
  id           String     @id @default(uuid())
  name         String     // "Court A", "Court B"
  venueId      String
  pricePerHour Float
  isActive     Boolean    @default(true)
  courtType    String?    // "5-a-side", "7-a-side"
  surfaceType  String?    // "Artificial Grass", "Natural Grass", "Hard"
  isIndoor     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  venue        Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  timeSlots    TimeSlot[]
  bookings     Booking[]

  @@index([venueId])
  @@map("courts")
}

model TimeSlot {
  id          String   @id @default(uuid())
  courtId     String
  startTime   String   // "08:00"
  endTime     String   // "09:00"
  dayOfWeek   Int      // 0-6 (Sunday-Saturday)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  court       Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, startTime, dayOfWeek])
  @@map("time_slots")
}

// --------------------------------------
// 4. Booking & Payment Models
// --------------------------------------

model Booking {
  id              String        @id @default(uuid())
  venueId         String?
  userId          String
  courtId         String
  bookingDate     DateTime
  startTime       String        // "08:00"
  endTime         String        // "09:00"
  totalHours      Float
  totalPrice      Float
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  notes           String?
  otp             String?
  idempotencyKey  String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  venue           Venue?        @relation(fields: [venueId], references: [id], onDelete: SetNull)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  court           Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)
  payment         Payment?

  @@index([userId])
  @@index([venueId])
  @@index([courtId])
  @@map("bookings")
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  amount        Float
  paymentMethod String        // "KHALTI", "eSewa", "Cash", "Card"
  transactionId String?       // Khalti pidx or external transaction ref
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}