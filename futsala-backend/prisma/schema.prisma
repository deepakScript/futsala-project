// Multi-Tenant Futsal Marketplace Schema (Idempotent Architecture)
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// Enums
// --------------------------------------

enum UserRole {
  SUPERADMIN
  TENANT_ADMIN
  CUSTOMER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// --------------------------------------
// 1. Tenant & User Models
// --------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  // Relations
  users    User[]
  venues   Venue[]
  bookings Booking[]
  payments Payment[]
  courts   Court[]

  @@map("tenants")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  fullName    String
  phoneNumber String
  isVerified  Boolean  @default(false)
  role        UserRole @default(CUSTOMER)
  tenantId    String? // ONLY populated if role is TENANT_ADMIN
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  bookings      Booking[]
  payments      Payment[]
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@map("users")
}

// --------------------------------------
// 2. Futsal Venue & Court Models
// --------------------------------------

model Venue {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  address     String
  city        String
  phoneNumber String
  images      String[] @default([])
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courts   Court[]
  bookings Booking[]

  @@index([tenantId])
  @@map("venues")
}

model Court {
  id           String  @id @default(uuid())
  tenantId     String
  venueId      String
  name         String
  pricePerHour Decimal @db.Decimal(10, 2)
  isActive     Boolean @default(true)

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId])
  @@map("courts")
}

// --------------------------------------
// 3. Booking & Payment Models (With DB-Level Idempotency)
// --------------------------------------

model Booking {
  id          String        @id @default(uuid())
  tenantId    String
  userId      String
  venueId     String
  courtId     String
  bookingDate DateTime      @db.Date
  startTime   String // "07:00"
  endTime     String // "08:00"
  totalPrice  Decimal       @db.Decimal(10, 2)
  status      BookingStatus @default(PENDING)

  // Client-generated UUID to intercept duplicate API booking submissions
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  court    Court     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  payments Payment[]

  // Hard physical block: Protects against double-booking the same hour slot
  @@unique([courtId, bookingDate, startTime])
  @@index([tenantId, bookingDate])
  @@map("bookings")
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  bookingId     String
  userId        String
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod String // "KHALTI", "ESEWA", "CASH"
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  // Crucial fields for gateway synchronization and retry mapping
  transactionId  String? @unique // Unique reference tracking code sent by eSewa/Khalti
  idempotencyKey String  @unique // Unique UUID generated by client frontend before payment execution

  // Relations
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([tenantId])
  @@map("payments")
}

// --------------------------------------
// 4. Authentication & Refresh Token Model
// --------------------------------------

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
